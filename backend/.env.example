# ---------------------------------------------------------------------------
# CampusLoop backend environment template
# Copy this file to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (production / local server install)
# DATABASE_URL=postgresql+psycopg://campusloop:change_me@localhost:5432/campusloop
#
# SQLite fallback for a machine without PostgreSQL (development only)
DATABASE_URL=sqlite:///./campusloop.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local file storage (public product images / private verification documents)
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
MAX_DOCUMENT_MB=10

# Marketplace rules
# false -> every new listing waits for admin approval
AUTO_APPROVE_LISTINGS=false
OFFER_EXPIRY_HOURS=72
RATE_LIMIT_ENABLED=true

# Seed admin account used by `python -m app.db.seed`
SEED_ADMIN_EMAIL=admin@campusloop.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=false

# Future AI feature flags (rule-based pricing is always available)
AI_PRICE_PREDICTION_ENABLED=false
AI_RECOMMENDATIONS_ENABLED=false
AI_SEMANTIC_SEARCH_ENABLED=false
AI_LISTING_ASSISTANT_ENABLED=false
AI_IMAGE_CLASSIFICATION_ENABLED=false
AI_FRAUD_DETECTION_ENABLED=false
AI_DUPLICATE_DETECTION_ENABLED=false
AI_ASSISTANT_ENABLED=false
